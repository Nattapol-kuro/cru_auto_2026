void fullcode() {
  if (digitalRead(65) == 0) {
    t(150, 0.025, 0.27977, 250);
    yt(11);
    smsv2(13, 1);
    smsv3(70, 1);
    cheks_eye(150, 0.02, 0.177555, 120);
    cheks_eye(50, 0.01, 0.1145555, 530);
    keep_r();
    tl_360_slow();
    yt(10);
    cheks_r(130, 0.021, 0.15, 30);
    tr(105);
    cross(130, 0.02, 0.01, 30);
    tr(120);
    // cheks_r(120, 0.04, 0.52, 60);
    t(120, 0.042, 0.48, 100);
    cheks_r(170, 0.082, 0.7375, 25);
    tr(160);
    smsv2(13, 1);
    smsv3(70, 1);
    cheks_eye(45, 0.011, 0.023, 525);
    keep_l();
    mct(-100, -100, 210);
    tr(120);
    // cheks_r(120, 0.04, 0.52, 60);
    cheks_r(170, 0.082, 0.7375, 13);
    yt(10);
    tr3(110);
    yt(10);
    cross(150, 0.02, 0.023, 100);
    cross(150, 0.02, 0.023, 10);
    tr(150);
    cheks_l(160, 0.02422, 0.27777, 30);
    trb(180);
    yt(10);
    b_cross(80);
    smsv2(0, 3);
  }
  if (digitalRead(64) == 0) {
    t(150, 0.025, 0.27777, 250);
    yt(11);
    smsv2(13, 1);
    smsv3(70, 1);
    cheks_eye(150, 0.02, 0.174555, 125);
    cheks_eye(50, 0.01, 0.1145555, 530);
    keep_l();
    tl_360_slow();
    yt(10);
    cheks_r(130, 0.021, 0.15, 30);
    tr(105);
    cheks_l(130, 0.02, 0.1, 30);
    tl(105);
    cheks_r(150, 0.029, 0.55, 10);
    tr(130);
    cheks_r(130, 0.02, 0.1, 42);
    tr(105);
    yt(10);
    smsv2(13, 1);
    smsv3(70, 1);
    cheks_eye(70, 0.012, 0.024, 510);
    keep_r();
    B_cross(70, 115);
    tl(50);
    cheks_r(130, 0.02, 0.1, 32);
    tr(70);
    cheks_ll(200, 0.025, 0.32534, 0);
    trb(180);
    yt(10);
    b_cross(80);
    smsv2(0, 3);
  }
  stop();
}


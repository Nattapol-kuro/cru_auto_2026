void pink() {
  t(150, 0.025, 0.27977, 250);
  cheks_eye(140, 0.02, 0.177555, 120);
  yt(11);
  smsv2(0, 1);
  smsv3(70, 1);
  cheks_eye(50, 0.01, 0.1145555, 520);
  keep_l();
  tl_360_slow();
  yt(10);
  cheks_r(130, 0.021, 0.15, 20);
  tr(100);
  cross(130, 0.027, 0.032, 50);
  cross(150, 0.027, 0.032, 100);
  cross(150, 0.027, 0.032, 10);
  tr(150);
  cheks_l(160, 0.02422, 0.27777, 5);
  trb(180);
  yt(10);
  b_cross(80);
  smsv2(0, 3);
  stop();
}


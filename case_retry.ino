int count = 0;
void fullcode_retry() {
  while (digitalRead(7) == 1) {
    tone(4, 3000, 100);
    count = 1;
  }
  if (digitalRead(65) == 0) {
    if (count == 0) {
      t(150, 0.025, 0.27977, 250);
      cheks_eye(140, 0.02, 0.177555, 120);
      yt(11);
      smsv2(0, 1);
      smsv3(70, 1);
      cheks_eye(50, 0.01, 0.1145555, 520);
      keep_r();
      tl_360_slow();
      yt(10);
      cheks_r(130, 0.021, 0.15, 30);
      tr(105);
      cross(130, 0.02, 0.01, 20);
      tr(120);
      // cheks_r(120, 0.04, 0.52, 60);
      t(120, 0.042, 0.48, 100);
      scheks_r(160, 0.082, 0.7375, 10);
      tr(160);
      smsv2(10, 1);
      smsv3(70, 1);
      cheks_eye(45, 0.011, 0.023, 575);
      keep_l();
      mct(-100, -100, 210);
      tr(120);
      // cheks_r(120, 0.04, 0.52, 60);
      t(120, 0.042, 0.48, 100);
      scheks_r(170, 0.082, 0.7375, 0);
      yt(10);
      tr3(110);
      yt(10);
      cross(150, 0.025, 0.027, 100);
      cross(150, 0.025, 0.027, 10);
      tr(150);
      cheks_l(160, 0.02422, 0.27777, 5);
      trb(170);
      yt(10);
      bt(80, 100);
      b_cross(80);
      smsv2(0, 3);
    } else if (count == 1) {
      green();
    }
    stop();
  }
  if (digitalRead(64) == 0) {
    if (count == 0) {
      t(150, 0.025, 0.27977, 250);
      cheks_eye(140, 0.02, 0.177555, 120);
      yt(11);
      smsv2(13, 1);
      smsv3(70, 1);
      cheks_eye(50, 0.01, 0.1145555, 535);
      keep_l();
      tl_360_slow();
      yt(10);
      cheks_r(130, 0.025, 0.15, 30);
      tr(105);
      cheks_l(130, 0.02, 0.1, 30);
      tl(105);
      cheks_r(150, 0.029, 0.3, 0);
      tr(100);
      t(130, 0.02, 0.1, 100);
      cheks_r(130, 0.02, 0.1, 27);
      tr(105);
      yt(10);
      smsv2(13, 1);
      smsv3(70, 1);
      cheks_eye(70, 0.015, 0.028, 515);
      delay(30);
      keep_r();
      B_cross(70, 115);
      tl(50);
      cheks_r(130, 0.02, 0.1, 19);
      tr(70);
      t(200, 0.025, 0.32534, 700);
      cheks_ll(160, 0.02422, 0.27777, 5);
      trb(170);
      yt(10);
      bt(80, 100);
      b_cross(80);
      smsv2(0, 3);
    } else if (count == 1) {
      yellow();
    }
    stop();
  }
  if (digitalRead(8) == 1) {
    delay(500);
    tone(4, 3000, 100);
    pink();
  }
  stop();
}